# AnkiPaper configuration. Copy to .env and adjust.

# Cookie session lifetime in days.
ANKIPAPER_COOKIE_MAX_AGE_DAYS=30

# True if the application runs behind a trusted upstream proxy that
# terminates TLS. Enables Secure cookies, X-Forwarded-For IP trust, and
# proxy-aware canonical URLs. Preferred name is
# ANKIPAPER_TRUSTED_UPSTREAM_HTTPS_PROXY; ANKIPAPER_BEHIND_PROXY is the
# legacy alias and is deprecated.
# ANKIPAPER_TRUSTED_UPSTREAM_HTTPS_PROXY=false

# Hosts (exact match or '*.suffix') for which the session cookie is set
# without the Secure flag. Required when the same process serves both
# Cloudflare-fronted HTTPS and a direct LAN access over plain HTTP.
# Comma-separated list.
# ANKIPAPER_COOKIE_INSECURE_HOSTS=ankipaper.lan,192.168.1.10

# If true, the access-log middleware dumps every incoming request header,
# including the full Cookie header. Useful when diagnosing client-IP /
# proxy-header issues. OFF in production.
# ANKIPAPER_DEBUG_HEADERS=false

# Show a link to privacy policy in footer.
# ANKIPAPER_SHOW_PRIVACY_POLICY=false

# Redis connection URL used by the login rate limiter. Override only if
# you run Redis outside of docker compose.
ANKIPAPER_REDIS_URL=redis://redis:6379/0

# Login rate limits (defaults shown). Counters are incremented BEFORE the
# AnkiWeb call; a successful login clears them.
# ANKIPAPER_LOGIN_IP_MAX_ATTEMPTS=5
# ANKIPAPER_LOGIN_IP_WINDOW_SECONDS=60
# ANKIPAPER_LOGIN_USER_MAX_ATTEMPTS=10
# ANKIPAPER_LOGIN_USER_WINDOW_SECONDS=3600

# Media-sync limits. Files larger than MEDIA_MAX_FILE_BYTES are skipped
# during sync. If the existing collection.media/ already exceeds
# MEDIA_MAX_COLLECTION_BYTES, no new files are written.
# ANKIPAPER_MEDIA_MAX_FILE_BYTES=1048576
# ANKIPAPER_MEDIA_MAX_COLLECTION_BYTES=209715200

# Maximum total size of `/data` for new accounts; existing accounts remain accessible.
# 0 = unlimited
# ANKIPAPER_DATA_MAX_BYTES=0

# Public origin used in canonical, Open Graph and sitemap URLs
# (for example, https://ankipaper.study). Empty -> the URL is derived
# from the incoming request (requires ANKIPAPER_BEHIND_PROXY=true).
# ANKIPAPER_PUBLIC_URL=

# Product name surfaced in OG/site_name and brand alt text.
# ANKIPAPER_BRAND_NAME=AnkiPaper

# Default meta description and OG/Twitter description used on the landing page.
# ANKIPAPER_META_DESCRIPTION="AnkiPaper is a free web app that lets you review your Anki flashcards in a Kindle or e-ink browser. Sign in with your AnkiWeb account — no signup, no install, no tracking."
