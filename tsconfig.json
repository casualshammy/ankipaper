{
  "compilerOptions": {
    "target": "ES6",
    "module": "esnext",
    "lib": ["DOM", "ES2015"],
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "paths": {
      "@spa/*": ["./app/web/static/js/study_spa/*"],
      "@deck/*": ["./app/web/static/js/deck_tree/*"]
    }
  },
  "include": ["app/web/static/js/**/*.ts", "tests/study-spa/**/*.ts", "tests/deck-tree/**/*.ts"]
}
