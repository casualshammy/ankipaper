# Конфигурация kindlanki. Скопируйте в .env и заполните.

# Публичный URL приложения (используется в абсолютных ссылках).
KINDLANKI_BASE_URL=http://localhost:8000

# Каталог для постоянных данных.
KINDLANKI_DATA_DIR=/data

# Файл с секретом для подписи cookie-сессий (создаётся автоматически).
KINDLANKI_SESSION_SECRET_FILE=/data/session.secret

# Время жизни cookie-сессии в днях.
KINDLANKI_COOKIE_MAX_AGE_DAYS=30

# True, если приложение работает за reverse proxy (включает Secure-cookie).
KINDLANKI_BEHIND_PROXY=false

# Endpoint AnkiWeb для sync-протокола. По умолчанию https://sync.ankiweb.net/.
# KINDLANKI_ANKIWEB_ENDPOINT=