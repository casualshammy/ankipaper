# kindlanki configuration. Copy to .env and adjust.

# Cookie session lifetime in days.
KINDLANKI_COOKIE_MAX_AGE_DAYS=30

# True if the application runs behind a reverse proxy (enables Secure cookie).
KINDLANKI_BEHIND_PROXY=false

# Redis connection URL used by the login rate limiter. Override only if
# you run Redis outside of docker compose.
KINDLANKI_REDIS_URL=redis://redis:6379/0

# Login rate limits (defaults shown). Counters are incremented BEFORE the
# AnkiWeb call; a successful login clears them.
# KINDLANKI_LOGIN_IP_MAX_ATTEMPTS=5
# KINDLANKI_LOGIN_IP_WINDOW_SECONDS=60
# KINDLANKI_LOGIN_USER_MAX_ATTEMPTS=10
# KINDLANKI_LOGIN_USER_WINDOW_SECONDS=3600

# Media-sync limits. Files larger than MEDIA_MAX_FILE_BYTES are skipped
# during sync. If the existing collection.media/ already exceeds
# MEDIA_MAX_COLLECTION_BYTES, no new files are written.
# KINDLANKI_MEDIA_MAX_FILE_BYTES=1048576
# KINDLANKI_MEDIA_MAX_COLLECTION_BYTES=209715200